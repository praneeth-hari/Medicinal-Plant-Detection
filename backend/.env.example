# ============================================================
# Medicinal Plant Detection & RAG Assistant — Environment Vars
# ============================================================
# Copy this file to `.env` and fill in the values.
# ============================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./medicinal_plants.db

# --- ML Model ---
MODEL_PATH=./ml_models/plant_classifier

# --- File Uploads ---
UPLOAD_DIR=./uploads

# --- Debug Mode ---
DEBUG=true

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
