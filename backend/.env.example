# ============================================================
# Medicinal Plant Detection & RAG Assistant — Environment Vars
# ============================================================
# Copy this file to `.env` and fill in the values.
# ============================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./medicinal_plants.db

# --- Authentication / JWT ---
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- ML Model ---
MODEL_PATH=./ml_models/plant_classifier

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./chroma_data

# --- File Uploads ---
UPLOAD_DIR=./uploads

# --- Debug Mode ---
DEBUG=true
