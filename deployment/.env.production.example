# ============================================================
# .env.production.example
# Production Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ----- Application -----
ENVIRONMENT=production
DEBUG=false

# ----- Database -----
DATABASE_URL=postgresql://user:password@db-host:5432/medicinal_plants
# DATABASE_URL=sqlite:///./data/app.db   # For SQLite (dev only)

# ----- Security -----
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ----- OpenAI / LLM -----
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# ----- ChromaDB (Vector Store) -----
CHROMA_PERSIST_DIR=./data/embeddings
CHROMA_COLLECTION_NAME=medicinal_plants

# ----- ML Model -----
MODEL_PATH=./data/models/best_model.pt
MODEL_NAME=resnet50
NUM_CLASSES=40

# ----- File Upload -----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# ----- CORS -----
CORS_ORIGINS=["https://yourdomain.com"]

# ----- Frontend -----
VITE_API_URL=https://yourdomain.com/api/v1
